# Database (SQLite by default; swap provider in prisma/schema.prisma for Postgres)
DATABASE_URL="file:./dev.db"

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin login
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-please"
# Long random string used to sign the admin session cookie
ADMIN_SESSION_SECRET="replace-with-a-64-char-random-string"

# Razorpay (test mode keys from https://dashboard.razorpay.com/app/keys)
# Leave blank to hide the Razorpay option at checkout.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Defaults used by the seed script (all editable later in Admin → Offers & Settings)
WHATSAPP_NUMBER="919876543210"
UPI_ID="yourshop@upi"
DIWALI_DATE="2026-11-08T18:00:00+05:30"
