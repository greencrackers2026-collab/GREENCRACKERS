# Supabase dashboard → Connect → Framework → React / Vite. The publishable (anon) key is public by design;
# Row Level Security protects the data. Never put a secret / service_role key here.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Public site URL (canonical URLs, sitemap, Open Graph)
VITE_SITE_URL="http://localhost:5173"
